# Auto detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Explicit text file formats with language-aware diff drivers
*.cs text diff=csharp
*.csproj text
*.sln text eol=crlf
*.props text
*.targets text

*.ts text
*.js text
*.json text
*.css text
*.html text
*.xml text
*.md text

# Shell scripts & batch files
*.sh text eol=lf
*.bash text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary file formats
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.zip binary
*.tar.gz binary
*.dll binary
*.exe binary
*.wasm binary
