# ==============================================================================
# Chauffr AI - .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# .NET / C# Build Outputs & Temporary Files
# ------------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
[Tt]est[Rr]esults/
[Bb]uild[Ll]og.*

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Publish / Package outputs
publish/
*.nupkg
*.snupkg
*.appx
*.appxbundle
project.lock.json
project.fragment.lock.json
artifacts/

# Visual Studio & Rider caches
.vs/
.idea/
*.DotSettings.user
_ReSharper*/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# ------------------------------------------------------------------------------
# Node.js / TypeScript / Web Component Widget
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json.bak

# TypeScript compiler cache & declaration map artifacts
*.tsbuildinfo

# ------------------------------------------------------------------------------
# Environment & Secret Configurations
# ------------------------------------------------------------------------------
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
appsettings.Production.json
appsettings.*.local.json
secrets.json

# ------------------------------------------------------------------------------
# Vector Store / Local Databases & Docker Mounts
# ------------------------------------------------------------------------------
qdrant_storage/
qdrant_snapshots/
data/
*.db
*.sqlite
*.sqlite3

# ------------------------------------------------------------------------------
# Playwright & Browser Automation
# ------------------------------------------------------------------------------
playwright-report/
test-results/
playwright/.cache/
.playwright/

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory
